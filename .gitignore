# A leading "/" anchors a rule to the repo root: "/data/" ignores only the
# top-level data folder, not src/data/ (code) or docs/data/ (data cards).

# Reference papers (copyrighted PDFs, kept local only)
/papers/

# --- Data: corpora, queries, qrels, indexes (rebuilt by scripts; see the data cards) ---
# "/data/*" (not "/data/") so one folder can be re-included: data/romanized/ holds
# the romanized query files, which are small and partly impossible to regenerate
# (LLM output, hand-typed queries), so they are versioned.
/data/*
!/data/romanized/

# --- Models and large artefacts (rebuilt from configs) ---
/models/
*.pt
*.bin
*.safetensors
*.ckpt
*.onnx

# --- Indexes and cached embeddings (in case one is written outside data/) ---
*.faiss
*.npy
*.npz
indexes/
**/index/

# --- Secrets ---
.env
.env.*
!.env.example
*.token

# --- Python and tool caches ---
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# --- OS and editor files ---
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
